{
  "manifest_version": 3,
  "name": "OmniMark",
  "version": "2.0.2",
  "author": "Nicolas",
  "description": "Votre Dashboard de Navigation : Favoris personnalisés, Streaming (Twitch/Kick) unifié et YouTube sans Shorts.",
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "chrome_settings_overrides" : {
    "homepage": "src/index.html"
   },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnimark@nicolas.projets",
      "data_collection_permissions": {
        "required": ["bookmarksInfo", "websiteContent"],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "https://*.youtube.com/*",
    "https://cdn.simpleicons.org/*",
    "https://img.logo.dev/*",
    "*://*.workers.dev/*",
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
