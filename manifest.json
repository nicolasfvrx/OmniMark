{
  "manifest_version": 3,
  "name": "OmniMark",
  "version": "1.3.0",
  "author": "Nicolas",
  "description": "Votre page de démarrage personnalisée, synchronisée et dotée de raccourcis de recherche puissants.",
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "chrome_settings_overrides" : {
    "homepage": "src/index.html"
   },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnimark@nicolas.projets",
      "data_collection_permissions": {
        "required": ["bookmarksInfo", "websiteContent"],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "https://*.youtube.com/*",
    "https://cdn.simpleicons.org/*",
    "https://img.logo.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/js/content-youtube.js"],
      "css": ["src/css/content-youtube.css"]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
