{
  "manifest_version": 3,
  "name": "OmniMark",
  "version": "1.0.2",
  "author": "Nicolas",
  "license": "MIT",
  "description": "Votre page de démarrage personnalisée, synchronisée et dotée de raccourcis de recherche puissants.",
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnimark@nicolas.projets"
    }
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
